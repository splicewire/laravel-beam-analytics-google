{
    "name": "splicewire/laravel-beam-analytics-google",
    "description": "The Google Analytics child: a GA4 Data API TrafficSource for laravel-beam-analytics, install scope only. See AGENTS.md.",
    "keywords": [
        "laravel",
        "splicewire",
        "beam",
        "extension"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/php-popcorn": "dev-main",
        "saloonphp/saloon": "^4.0.1",
        "spatie/laravel-package-tools": "^1.16",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-analytics": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\AnalyticsGoogle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\AnalyticsGoogle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\AnalyticsGoogle\\BeamAnalyticsGoogleServiceProvider"
            ]
        },
        "package-topology": {
            "because": "an extension is a Composer Beam Extension: it registers DOWN into manifests the host's beam already binds (install steps, nav seats, particle resources), so it requires beam and nothing above it. It never requires the marketplace (an extension that dragged beam-market in could not install on the bare Beam site it exists for; see splicewire/beam-extension-demo), tower, a satellite or a tower-* package: those tiers compose extensions, never the reverse.",
            "mustRequire": [
                "splicewire/laravel-beam"
            ],
            "mustNotRequire": [
                "splicewire/laravel-beam-market",
                "splicewire/tower",
                "splicewire/laravel-satellite*",
                "splicewire/laravel-tower-*"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-filters.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-nav.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-doctor.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-versioning.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-frame.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/php-json-ns.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-analytics.git"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
